# Extension build-time configuration (Vite). Copy to extension/.env for a
# production build:  cp extension/.env.example extension/.env
# .env is git-ignored. These are PUBLIC values (publishable key, backend URL) —
# no secrets live in the extension.

# Clerk publishable key. When set, the extension uses the Clerk sign-in flow.
# Leave UNSET for local dev to keep the dev (shared-secret) sign-in.
#   dev instance:  pk_test_...    production instance:  pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsubWF0dGdyYW50Zm9yY29uZ3Jlc3Mub3JnJA

# Backend base URL baked into the build (your deployed HTTPS service). Takes
# precedence over the runtime apiBase. Leave unset for local dev.
#   e.g. https://matt-grant-service.onrender.com
VITE_API_BASE=
