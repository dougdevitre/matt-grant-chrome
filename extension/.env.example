# Extension build-time config (Vite injects VITE_* into the bundle).
# Copy to `extension/.env` (gitignored) and `npm run build:extension`.

# Clerk publishable key — PUBLIC, safe to ship in the bundle. Set this to enable
# the in-panel Clerk sign-in. Leave EMPTY to run Dev sign-in only (local / CI),
# in which case the Clerk tab falls back to manual session-token paste.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsubWF0dGdyYW50Zm9yY29uZ3Jlc3Mub3JnJA

# Optional: a Clerk JWT template name that injects a `role` claim from
# publicMetadata.role. Leave EMPTY if the default session token already carries
# the role (the backend reads publicMetadata.role, then a top-level `role`).
VITE_CLERK_JWT_TEMPLATE=

# Default backend URL baked into the build so a downloaded extension talks to
# the deployed service with no setup. Leave EMPTY for local dev (falls back to
# http://localhost:8787). A URL saved in the panel still overrides this.
VITE_DEFAULT_SERVICE_URL=https://ezvnqn5e5i.us-east-1.awsapprunner.com
