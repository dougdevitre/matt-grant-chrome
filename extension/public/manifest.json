{
  "manifest_version": 3,
  "key": "",
  "name": "Matt Grant for Congress — Campaign Tools",
  "version": "0.1.0",
  "description": "Role-aware campaign productivity panel for voter registration and GOTV (MO-02, Aug 4 2026).",
  "action": {
    "default_title": "Open Campaign Tools",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "cookies",
    "geolocation"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "https://ezvnqn5e5i.us-east-1.awsapprunner.com/*",
    "https://clerk.mattgrantforcongress.org/*"
  ],
  "optional_host_permissions": [
    "https://sos.mo.gov/*",
    "https://*.sos.mo.gov/*",
    "https://airtable.com/*",
    "https://*.airtable.com/*",
    "https://docs.google.com/*",
    "https://*.docs.google.com/*",
    "https://sheets.google.com/*",
    "https://*.sheets.google.com/*",
    "https://stlouiscountymo.gov/*",
    "https://*.stlouiscountymo.gov/*",
    "https://sccmo.org/*",
    "https://*.sccmo.org/*",
    "https://franklinmo.org/*",
    "https://*.franklinmo.org/*",
    "https://warrencountymoclerk.com/*",
    "https://*.warrencountymoclerk.com/*",
    "https://mail.google.com/*",
    "https://*.mail.google.com/*",
    "https://calendar.google.com/*",
    "https://*.calendar.google.com/*",
    "https://winred.com/*",
    "https://*.winred.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "https://facebook.com/*",
    "https://*.facebook.com/*",
    "https://instagram.com/*",
    "https://*.instagram.com/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
