{
  "name": "matt-grant-chrome",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension + backend microservice for Matt Grant for Congress clerk productivity (MO-02, Aug 4 2026).",
  "license": "MIT",
  "workspaces": [
    "extension",
    "service"
  ],
  "scripts": {
    "dev:service": "npm run dev --workspace service",
    "build:service": "npm run build --workspace service",
    "build:extension": "npm run build --workspace extension",
    "build:download": "npm run build:extension && node service/scripts/pack-extension.mjs",
    "typecheck": "npm run typecheck --workspace service && npm run typecheck --workspace extension",
    "build": "npm run build:service && npm run build:extension",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
