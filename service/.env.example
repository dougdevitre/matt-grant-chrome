# Local dev configuration for the matt-grant-chrome microservice.
# Copy to .env (`cp service/.env.example service/.env`) and adjust as needed.
# .env is git-ignored — never commit real secrets.

# --- Core ---
PORT=8787
NODE_ENV=development
# Dev allows any origin so the unpacked extension can call the API. In
# production this MUST be pinned to the extension origin and the service
# refuses to boot with "*".
ALLOWED_ORIGIN=*

# --- Auth (dev driver) ---
# JWT signing secret. Any non-empty string works locally; in production this
# must be a strong secret loaded from SSM and NOT the default.
JWT_SECRET=dev-screenshot-secret
# Driver: "dev" (shared-secret sign-in) for local; "clerk" in production.
AUTH_DRIVER=dev
# The access code you type on the extension sign-in screen.
DEV_AUTH_SECRET=dev-only-change-me
# Token lifetimes (seconds).
TOKEN_TTL_SECONDS=3600
STEPUP_TTL_SECONDS=300

# --- Storage ---
# "memory" = in-process seeded demo data (tasks, an event, contacts). Great for
# testing. Switch to "airtable" with the vars below for persistence.
STORE_DRIVER=memory

# --- SMS (off by default; highest-risk capability) ---
SMS_DRIVER=noop
SMS_ENABLED=false
# SMS_DAILY_CAP=200

# --- Optional production drivers (leave unset for local testing) ---
# CLERK_JWKS_URL=
# CLERK_ISSUER=
# AIRTABLE_PAT=
# AIRTABLE_BASE_ID=appiuSYCexFUmGIOr
# CALENDAR_DRIVER=noop
# GOOGLE_CALENDAR_TOKEN=
# GOOGLE_CALENDAR_ID=
# MAILER_DRIVER=noop
# GMAIL_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_WEBHOOK_URL=
# SSM_PREFIX=/matt-grant-chrome/dev
