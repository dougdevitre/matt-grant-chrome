# matt-grant-chrome service configuration.
# Copy to service/.env for local dev. In production, prefer AWS SSM SecureString
# for every secret (getConfig reads SSM first, then env). NEVER commit real secrets.

# --- Core ---
NODE_ENV=development
PORT=8787
# Structured-log verbosity: debug | info | warn | error
LOG_LEVEL=info
# Pin to the extension origin(s) in production (comma-separated). "*" is refused at boot in prod.
ALLOWED_ORIGIN=*
# Signing key for the scoped clerk JWT. REQUIRED; prod refuses to boot on the default/missing value.
JWT_SECRET=dev-only-change-me
TOKEN_TTL_SECONDS=3600
STEPUP_TTL_SECONDS=300

# --- Auth driver ---
# Must be set explicitly (no default): dev (non-prod, requires DEV_AUTH_SECRET) | clerk
AUTH_DRIVER=dev
DEV_AUTH_SECRET=dev-only-change-me
CLERK_JWKS_URL=
CLERK_ISSUER=
# Optional: when set, Clerk tokens must carry this audience.
CLERK_AUDIENCE=

# --- Storage driver ---
# memory (default) | airtable  (see docs/airtable-setup.md)
STORE_DRIVER=memory
AIRTABLE_PAT=
AIRTABLE_BASE_ID=appiuSYCexFUmGIOr
# Required in production when STORE_DRIVER=airtable: keyed-HMAC salt so contact
# opt-out/outbox keys aren't offline-reversible to PII. Generate: openssl rand -hex 32
CONTACT_KEY_SALT=

# --- Compliance ---
# Exact FEC-registered committee name checked in every "Paid for by" disclaimer.
COMMITTEE_NAME=Matt Grant for Congress

# --- Calendar driver ---
# noop (default) | google  (service account; see docs/google-oauth-setup.md)
CALENDAR_DRIVER=noop
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_SUBJECT=
GOOGLE_CALENDAR_TOKEN=

# --- Mailer driver ---
# noop (default) | gmail
MAILER_DRIVER=noop
GMAIL_SUBJECT=
GMAIL_FROM=
GMAIL_TOKEN=

# --- Google service account (shared by Calendar + Gmail) ---
# Either GOOGLE_SA_JSON (the whole key file) OR the client-email/private-key pair.
GOOGLE_SA_JSON=
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=

# --- SMS driver (Twilio) ---
# noop (default) | twilio
SMS_DRIVER=noop
SMS_ENABLED=true
SMS_DAILY_CAP=250
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WEBHOOK_URL=

# TCPA quiet hours: no SMS outside an allowed local-time window. Enforcement is
# ON by default (set SMS_QUIET_ENABLED=false to disable). Hours are 24h clock in
# SMS_QUIET_TZ; the allowed window is [START, END). Recipient-local time is
# inferred from the contact's zip where possible, else SMS_QUIET_TZ. All of MO-02
# is Central, so the defaults below are correct for the district.
SMS_QUIET_ENABLED=true
SMS_QUIET_START=8
SMS_QUIET_END=21
SMS_QUIET_TZ=America/Chicago

# --- Public-data clients (optional keys) ---
CENSUS_API_KEY=
FEC_API_KEY=
DESE_API_BASE=
# Attach ACS demographics + OSM venues to /location/resolve when "true".
ENRICH_RESOLVE=false

# --- Shared state (multi-instance) ---
# Rate limits + the SMS daily cap are per-process by default. To run more than
# one instance, point these at Redis so the limits/cap are shared (otherwise
# each instance allows up to the full SMS cap). REQUIRE_SHARED_STATE=true makes
# production refuse to boot without REDIS_URL.
REDIS_URL=
# COUNTER_DRIVER=redis   # defaults to redis when REDIS_URL is set, else memory
REQUIRE_SHARED_STATE=false
# Behind an ALB/API Gateway, set the proxy hop count so req.ip is the real client.
TRUST_PROXY=

# --- Secrets backend ---
# Set to your SSM path prefix in deployed envs, e.g. /matt-grant-chrome/prod
SSM_PREFIX=
